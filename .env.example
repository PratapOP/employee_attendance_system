# ==========================================
# WorkPulse Enterprise Configuration
# ==========================================

# 1. PostgreSQL Database URL (Supabase / Neon / RDS / Railway)
# For Supabase serverless deployment, use the Connection Pooler (Transaction Mode, Port 6543):
# Example: postgresql://postgres.xxxx:[YOUR-PASSWORD]@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://postgres:password@db.project.supabase.co:5432/postgres?sslmode=require

# 2. Flask Application Secret Key (Generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=replace-with-a-cryptographically-secure-random-secret-key-32-chars

# 3. Environment & Debug Flag (Set to 0 in Production / Vercel)
FLASK_DEBUG=0
FLASK_ENV=production
